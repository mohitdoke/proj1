# Copy this file to .env (for local `vercel dev` / scripts) and to your
# Vercel project's Environment Variables (for deployment). Never commit the
# real .env file — only this .env.example template.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public/anon key. Not currently used by any server code in this repo (the
# frontend never talks to Supabase directly — see README "Architecture"),
# but listed here per spec / in case you add a client-side Supabase feature
# later. Safe to expose to the browser if you do (that's what "anon" means).
SUPABASE_ANON_KEY=your-anon-key

# SERVICE ROLE key — bypasses Row Level Security. Used ONLY by server-side
# code (lib/supabaseAdmin.js, imported from api/*.js and scripts/*.mjs).
# NEVER prefix this with VITE_ (Vite exposes VITE_-prefixed vars to the
# browser bundle) and never reference it from anything under src/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Manager upload gate -----------------------------------------------------
# Shared secret required to call POST /api/admin/mis/upload (see
# lib/apiHelpers.js requireAdmin). Generate any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# See README "Manager authentication" for upgrading this to real accounts.
ADMIN_UPLOAD_TOKEN=change-me-to-a-long-random-string

# --- Tavily (News & Industry research) --------------------------------------
# https://tavily.com — used server-side only (lib/research.js). Never
# exposed to the browser.
TAVILY_API_KEY=your-tavily-api-key
